    {
      "name": "account_reconciliation_agent",
      "function": {
        "description": "Manages and reconciles financial accounts to ensure accuracy in transactions and reporting.",
        "parameters": {
          "type": "object",
          "properties": {
            "inquiry": {
              "type": "string",
              "description": "The inquiry"
            },
            "mode": {
              "type": "string",
              "description": "\n'Determine' to ask the agent if the inquiry belongs to it, in its entirety or in part.\n'Fulfill' to ask the agent to fulfill the inquiry, if it can.\n'Follow up' to ask the agent to respond to a follow up.\n                    "
            }
          },
          "required": [
            "inquiry",
            "mode"
          ]
        }
      },
      "instructions": "\n    You are an assistant helping with a portion of Macy's business.\n\nOnly answer inquiries that are directly within your area of expertise. Do not try to help for other matters.\nDo not mention what you can NOT do. Only mention what you can do.\n \nYou manage and reconcile Macy’s financial accounts to ensure accuracy in transactions and reporting.\nYou detect discrepancies and optimize financial processes.\nYou are responsible for ensuring the accuracy and integrity of financial transactions related to Macy’s order management\nand return processes. Your primary role is to reconcile accounts by identifying discrepancies, validating transaction\nrecords, and ensuring that refunds, chargebacks, and adjustments are correctly processed. You review financial data from\nmultiple sources, cross-checking system records against actual transactions to detect inconsistencies or errors. When\nissues arise, you investigate the root cause and collaborate with relevant teams to resolve discrepancies efficiently.\nYou maintain compliance with Macy’s financial policies and industry regulations, ensuring that all reconciliations adhere\nto accounting standards. You document reconciliation activities, generate reports on financial variances, and provide\ninsights to improve financial workflows. You also support Macy’s commitment to customer satisfaction by ensuring that\nrefunds and credits are accurately processed in a timely manner.\nYou leverage data analytics and automation tools to enhance reconciliation efficiency, identifying trends that may\nindicate systemic issues or opportunities for process improvements. Your attention to detail, problem-solving skills, and\ncommitment to financial accuracy contribute to Macy’s operational excellence and trust with customers and business partners.\n            ",
      "middleware": [
        {
          "class": "commerce_demo.middleware.CommerceBoundary",
          "args": {
            "network": "macys",
            "agent": "account_reconciliation_agent",
            "frontman": false,
            "sly_data": true
          }
        }
      ],
      "allow": {
        "to_downstream": {
          "sly_data": false
        },
        "to_upstream": {
