    {
      "name": "CommerceArbiter",
      "class": "commerce_demo.tools.MacysCommerce",
      "function": {
        "description": "Mandatory coded authority for negotiated prices. Direct discussions are informational. Use catalog for direct inquiries; quote for arbiter-routed requests. Code sets all prices.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "catalog",
                "quote"
              ]
            }
          },
          "required": [
            "operation"
          ]
        }
      }
    }
  ]
